# ──────────────────────────────────────────
#  Autoqui Backend — Variáveis de Ambiente
#
#  Copie para .env e preencha todos os valores:
#  cp .env.example .env
# ──────────────────────────────────────────

# Servidor
PORT=3001
NODE_ENV=production

# ── Firebase Admin SDK ──────────────────────
# Gerado em: Firebase Console → Configurações → Contas de serviço → Gerar nova chave privada
# ATENÇÃO: no .env de produção, a FIREBASE_PRIVATE_KEY precisa das quebras de linha
# literalmente com \n (não quebra real). Exemplo:
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nLINHA1\nLINHA2\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=SEU_PROJECT_ID
FIREBASE_CLIENT_EMAIL=SEU_CLIENT_EMAIL@SEU_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END RSA PRIVATE KEY-----\n"

# ── OpenAI ──────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.3

# ── Evolution API ───────────────────────────
EVOLUTION_API_URL=https://evolution.vps.pequi.digital
EVOLUTION_API_KEY=SUA_API_KEY_AQUI

# ── Configurações do Bot ────────────────────
MESSAGE_DEBOUNCE_MS=13000
MAX_HISTORY_MESSAGES=20
MAX_TOOL_TURNS=5

# ── Lembretes ───────────────────────────────
REMINDER_HOURS_BEFORE=24

# ── MercadoPago (conta da plataforma Autoqui — NÃO dos clientes) ──
MP_ACCESS_TOKEN=APP_USR-...
# URL pública do backend — usada nas notification_url do MercadoPago
# Com nginx na mesma origem: https://seudominio.com
# Com backend separado: https://api.seudominio.com
BACKEND_URL=https://seudominio.com
FRONTEND_URL=https://seudominio.com

# ── Google Calendar OAuth2 ──────────────────────────
# Criar em: console.cloud.google.com → APIs → Credenciais → OAuth 2.0
# URI de redirecionamento autorizado: https://seudominio.com/calendar/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://seudominio.com/calendar/google/callback

# ── Segurança ───────────────────────────────────────
# Chave AES-256 para criptografar refresh tokens do Google Calendar
# Gere com: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=mude_para_uma_chave_aleatoria_de_32_chars!!

# ── Log Level (opcional) ────────────────────────────
# "debug" para logs extras de detalhe, omita para modo normal
# LOG_LEVEL=debug

# ── Trinks (opcional — configurado por empresa no Firestore) ──
# Não configura aqui — fica em companies/{companyId}.trinks no Firestore
